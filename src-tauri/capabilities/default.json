{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Motion Studio 主窗口的最小桌面权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:menu:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
